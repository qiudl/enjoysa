    "faqs": {
      "booking": [
        { "question": "如何预订旅游产品？", "answer": "您可以在我们的网站上浏览产品，选择合适的日期和人数后，点击「立即预订」按钮。按照提示完成支付即可完成预订。预订成功后，您将收到确认邮件和电子票据。" },
        { "question": "预订需要提前多久？", "answer": "建议您至少提前24-48小时预订，旺季期间（如学校假期、公共假日）建议提前1周预订。部分热门产品可能需要更早预订。" },
        { "question": "可以为他人预订吗？", "answer": "可以。您可以为家人、朋友预订产品，只需在预订时填写实际参与者的信息即可。" }
      ],
      "payment": [
        { "question": "支持哪些支付方式？", "answer": "我们支持多种支付方式，包括：微信支付、支付宝、银联卡、Visa/Mastercard信用卡等。所有支付均通过安全加密通道处理。" },
        { "question": "如何申请退款？", "answer": "如需退款，请在「我的订单」中找到相应订单，点击「申请退款」。我们会在1-3个工作日内审核您的申请。符合退款条件的订单将在5-10个工作日内退回原支付账户。" },
        { "question": "退款政策是怎样的？", "answer": "出发前7天以上取消可全额退款；出发前3-7天取消退还50%；出发前72小时内取消不予退款。具体政策可能因产品而异，请查看产品详情页的退款说明。" }
      ],
      "tour": [
        { "question": "行程包含接送吗？", "answer": "大部分产品提供阿德莱德市区酒店接送服务，具体接送安排请查看产品详情。部分产品可能需要自行前往集合点。" },
        { "question": "行程会因天气取消吗？", "answer": "如遇恶劣天气导致活动无法安全进行，我们会提前通知您并安排改期或全额退款。请确保预留准确的联系方式。" },
        { "question": "需要带什么物品？", "answer": "根据不同的活动类型，建议携带：舒适的步行鞋、防晒用品、帽子、相机、饮用水等。具体需携带物品请参考产品详情页的「温馨提示」。" }
