  "faq": {
    "title": "FAQ",
    "subtitle": "Find answers to frequently asked questions about EnjoySA",
    "categories": {
      "booking": "Booking",
      "payment": "Payment & Refunds",
      "tour": "Tour Arrangement",
      "other": "Other Questions"
    },
    "faqs": {
      "booking": [
        { "question": "How do I book a tour?", "answer": "Browse our products, select your preferred date and number of participants, then click \"Book Now\". Complete the payment to confirm your booking. You will receive a confirmation email with your e-ticket." },
        { "question": "How far in advance should I book?", "answer": "We recommend booking at least 24-48 hours in advance. During peak seasons (school holidays, public holidays), booking 1 week ahead is advised. Popular products may require earlier booking." },
        { "question": "Can I book for someone else?", "answer": "Yes. You can book for family and friends. Just enter the actual participant information when making the booking." }
      ],
      "payment": [
        { "question": "What payment methods are accepted?", "answer": "We accept multiple payment methods including WeChat Pay, Alipay, UnionPay, Visa/Mastercard credit cards. All payments are processed through secure encrypted channels." },
        { "question": "How do I request a refund?", "answer": "To request a refund, go to \"My Orders\", find the relevant order, and click \"Request Refund\". We will review your request within 1-3 business days. Eligible refunds will be processed within 5-10 business days." },
        { "question": "What is the refund policy?", "answer": "Full refund for cancellations 7+ days before departure; 50% refund for 3-7 days; no refund within 72 hours. Specific policies may vary by product - please check the product details." }
      ],
      "tour": [
        { "question": "Is hotel pickup included?", "answer": "Most products include pickup from Adelaide CBD hotels. Please check product details for specific pickup arrangements. Some products may require self-transport to the meeting point." },
        { "question": "Will tours be cancelled due to weather?", "answer": "If severe weather makes the activity unsafe, we will notify you in advance and arrange a reschedule or full refund. Please ensure your contact details are accurate." },
        { "question": "What should I bring?", "answer": "Depending on the activity, we recommend: comfortable walking shoes, sunscreen, hat, camera, drinking water. Check the product details page for specific recommendations." }
      ],
      "other": [
        { "question": "How can I contact customer service?", "answer": "You can reach us by: Phone +61 8 XXXX XXXX (business hours), Email support@enjoysa.com.au, or use the live chat feature on our website. We will respond as soon as possible." },
        { "question": "How do I submit a review?", "answer": "After completing your tour, you can leave a review in \"My Orders\". Your honest feedback helps other users make decisions and helps us improve our services." },
        { "question": "How can I become a partner?", "answer": "If you are a South Australian tourism provider, we welcome partnerships. Please email partner@enjoysa.com.au with your company introduction and product information." }
      ]
    },
